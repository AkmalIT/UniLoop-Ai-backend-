# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/uniloop

# Required: Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: LLM integration (leave blank to disable)
LLM_PROVIDER=
LLM_API_KEY=

# Public HH vacancy search. Set false to keep career recommendations local only.
# hh.uz is the default regional host; it can be changed to another supported HH host.
JOB_SEARCH_ENABLED=true
HH_HOST=hh.uz
# Required when JOB_SEARCH_ENABLED=true. Use an address monitored by your team.
HH_USER_AGENT=UniLoop-AI/1.0 (developer@example.com)
# Optional OAuth access token. HH may challenge anonymous requests from server IPs.
HH_ACCESS_TOKEN=

# Optional: S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Port the server listens on (Render injects $PORT automatically)
PORT=5001
CORS_ORIGINS=http://localhost:3000
STORAGE_ENABLED=false
SURVEY_STUDENT_URL=
SURVEY_PROFESSOR_URL=
# Fresh disposable databases only; seed refuses populated targets
SEED_DISPOSABLE=false
