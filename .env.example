# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/uniloop

# Required: Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: LLM integration (leave blank to disable)
LLM_PROVIDER=
LLM_API_KEY=

# Optional: S3-compatible object storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Port the server listens on (Render injects $PORT automatically)
PORT=5001
CORS_ORIGINS=http://localhost:3000
STORAGE_ENABLED=false
SURVEY_STUDENT_URL=
SURVEY_PROFESSOR_URL=
# Fresh disposable databases only; seed refuses populated targets
SEED_DISPOSABLE=false
